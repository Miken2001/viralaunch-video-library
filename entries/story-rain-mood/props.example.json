  "scenes": [
    {"text": "In the hills of northeast India, the rain hardly ever seems to stop.", "durationSeconds": 5},
    {"text": "The village of Mawsynram gets close to twelve metres of rain in an average year, among the most on Earth.", "durationSeconds": 6},
    {"text": "Most of it falls during the summer monsoon, from June to September.", "durationSeconds": 5},
    {"text": "Nearby Cherrapunji once recorded more than twenty-six metres of rain in twelve months, in 1860 and 1861.", "durationSeconds": 6},
    {"text": "Here, Khasi villagers guide the roots of rubber fig trees across streams to grow living bridges.", "durationSeconds": 6}
